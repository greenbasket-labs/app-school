generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                             String                           @id @default(uuid()) @db.Uuid
  email                          String                           @unique
  passwordHash                   String
  status                         UserStatus                       @default(ACTIVE)
  createdAt                      DateTime                         @default(now()) @db.Timestamptz(6)
  updatedAt                      DateTime                         @updatedAt @db.Timestamptz(6)
  auditEvents                    AuditEvent[]                     @relation("AuditActor")
  Guardian                       Guardian?
  GuardianAccountSecurity        GuardianAccountSecurity?
  GuardianPhoneVerificationToken GuardianPhoneVerificationToken[]
  memberships                    Membership[]
  Notification                   Notification[]
  ParentAccessInvitation         ParentAccessInvitation[]
  PaymentRecord                  PaymentRecord[]
  sessions                       UserSession[]
}

model Organization {
  id             String                @id @default(uuid()) @db.Uuid
  name           String
  normalizedName String
  status         OrganizationStatus    @default(SETUP)
  createdAt      DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime              @updatedAt @db.Timestamptz(6)
  memberships    Membership[]
  identity       OrganizationIdentity?
  schools        School[]
}

model OrganizationIdentity {
  id                  String                     @id @default(uuid()) @db.Uuid
  organizationId      String                     @unique @db.Uuid
  cacNumber           String
  normalizedCacNumber String                     @unique
  verificationStatus  IdentityVerificationStatus @default(SUPPLIED)
  createdAt           DateTime                   @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime                   @updatedAt @db.Timestamptz(6)
  organization        Organization               @relation(fields: [organizationId], references: [id])
}

model School {
  id                      String                    @id @default(uuid()) @db.Uuid
  organizationId          String                    @db.Uuid
  name                    String
  normalizedName          String
  address                 String?
  phone                   String?
  email                   String?
  status                  SchoolStatus              @default(SETUP)
  setupStatus             SetupStatus               @default(NOT_STARTED)
  createdAt               DateTime                  @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime                  @updatedAt @db.Timestamptz(6)
  academicSessions        AcademicSession[]
  assessments             AssessmentDefinition[]
  assessmentScores        AssessmentScore[]
  attendanceRecords       AttendanceRecord[]
  auditEvents             AuditEvent[]
  classLevels             ClassLevel[]
  feeStructures           FeeStructure[]
  guardians               Guardian[]
  IdempotencyRecord       IdempotencyRecord[]
  memberships             Membership[]
  membershipCapabilities  MembershipCapability[]
  Notification            Notification[]
  ParentAccessInvitation  ParentAccessInvitation[]
  PaymentIntent           PaymentIntent[]
  PaymentRecord           PaymentRecord[]
  PlatformJob             PlatformJob[]
  ResultAccessEntitlement ResultAccessEntitlement[]
  resultAccessSetting     ResultAccessSetting?
  ResultAccessTransaction ResultAccessTransaction[]
  ResultPaymentAttempt    ResultPaymentAttempt[]
  RuleDefinition          RuleDefinition[]
  organization            Organization              @relation(fields: [organizationId], references: [id])
  modules                 SchoolModule[]
  SchoolPaymentProvider   SchoolPaymentProvider[]
  commercialSubscription  SchoolSubscription?
  students                Student[]
  StudentFeeAssignment    StudentFeeAssignment[]
  StudentFeeInvoice       StudentFeeInvoice[]
  studentGuardians        StudentGuardian[]
  subjects                Subject[]

  @@index([organizationId])
  @@index([normalizedName])
}

model Module {
  id            String         @id @default(uuid()) @db.Uuid
  code          String         @unique
  name          String
  description   String?
  category      String
  sortOrder     Int            @default(0)
  createdAt     DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(6)
  schoolModules SchoolModule[]
}

model SchoolModule {
  schoolId   String    @db.Uuid
  moduleId   String    @db.Uuid
  enabled    Boolean   @default(false)
  enabledAt  DateTime? @db.Timestamptz(6)
  disabledAt DateTime? @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(6)
  module     Module    @relation(fields: [moduleId], references: [id])
  school     School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@id([schoolId, moduleId])
  @@index([schoolId, enabled])
}

model AcademicSession {
  id                      String                    @id @default(uuid()) @db.Uuid
  schoolId                String                    @db.Uuid
  name                    String
  startsAt                DateTime                  @db.Timestamptz(6)
  endsAt                  DateTime                  @db.Timestamptz(6)
  status                  AcademicSessionStatus     @default(DRAFT)
  createdAt               DateTime                  @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime                  @updatedAt @db.Timestamptz(6)
  school                  School                    @relation(fields: [schoolId], references: [id])
  terms                   AcademicTerm[]
  assessments             AssessmentDefinition[]
  assessmentScores        AssessmentScore[]
  attendanceRecords       AttendanceRecord[]
  classSubjects           ClassSubject[]
  enrollments             Enrollment[]
  feeStructures           FeeStructure[]
  ResultAccessEntitlement ResultAccessEntitlement[]
  ResultAccessTransaction ResultAccessTransaction[]
  ResultPaymentAttempt    ResultPaymentAttempt[]

  @@unique([schoolId, name])
  @@index([schoolId, startsAt])
}

model AcademicTerm {
  id                      String                    @id @default(uuid()) @db.Uuid
  name                    String
  order                   Int
  startsAt                DateTime                  @db.Timestamptz(6)
  endsAt                  DateTime                  @db.Timestamptz(6)
  academicSessionId       String                    @db.Uuid
  createdAt               DateTime                  @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime                  @updatedAt @db.Timestamptz(6)
  academicSession         AcademicSession           @relation(fields: [academicSessionId], references: [id])
  assessments             AssessmentDefinition[]
  feeStructures           FeeStructure[]
  ResultAccessEntitlement ResultAccessEntitlement[]
  ResultAccessTransaction ResultAccessTransaction[]
  ResultPaymentAttempt    ResultPaymentAttempt[]

  @@unique([academicSessionId, order])
  @@unique([academicSessionId, name])
  @@index([academicSessionId, startsAt])
}

model ClassLevel {
  id        String     @id @default(uuid()) @db.Uuid
  schoolId  String     @db.Uuid
  name      String
  order     Int
  createdAt DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @db.Timestamptz(6)
  arms      ClassArm[]
  school    School     @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, name])
  @@unique([schoolId, order])
  @@index([schoolId, order])
}

model ClassArm {
  id                String                 @id @default(uuid()) @db.Uuid
  classLevelId      String                 @db.Uuid
  name              String
  createdAt         DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime               @updatedAt @db.Timestamptz(6)
  assessments       AssessmentDefinition[]
  assessmentScores  AssessmentScore[]
  attendanceRecords AttendanceRecord[]
  classLevel        ClassLevel             @relation(fields: [classLevelId], references: [id])
  subjects          ClassSubject[]
  enrollments       Enrollment[]

  @@unique([classLevelId, name])
  @@index([classLevelId])
}

model Subject {
  id               String                 @id @default(uuid()) @db.Uuid
  schoolId         String                 @db.Uuid
  name             String
  code             String?
  createdAt        DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime               @updatedAt @db.Timestamptz(6)
  assessments      AssessmentDefinition[]
  assessmentScores AssessmentScore[]
  classSubjects    ClassSubject[]
  school           School                 @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, name])
  @@unique([schoolId, code])
  @@index([schoolId, name])
}

model ClassSubject {
  id                String          @id @default(uuid()) @db.Uuid
  academicSessionId String          @db.Uuid
  classArmId        String          @db.Uuid
  subjectId         String          @db.Uuid
  createdAt         DateTime        @default(now())
  academicSession   AcademicSession @relation(fields: [academicSessionId], references: [id])
  classArm          ClassArm        @relation(fields: [classArmId], references: [id])
  subject           Subject         @relation(fields: [subjectId], references: [id])

  @@unique([academicSessionId, classArmId, subjectId])
  @@index([academicSessionId, classArmId])
  @@index([academicSessionId, subjectId])
}

model AssessmentDefinition {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId          String            @db.Uuid
  academicSessionId String            @db.Uuid
  academicTermId    String            @db.Uuid
  classArmId        String            @db.Uuid
  subjectId         String            @db.Uuid
  name              String
  maxScore          Decimal           @db.Decimal(10, 2)
  createdAt         DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime          @default(now()) @updatedAt @db.Timestamptz(6)
  academicSession   AcademicSession   @relation(fields: [academicSessionId], references: [id])
  academicTerm      AcademicTerm      @relation(fields: [academicTermId], references: [id])
  classArm          ClassArm          @relation(fields: [classArmId], references: [id])
  school            School            @relation(fields: [schoolId], references: [id])
  subject           Subject           @relation(fields: [subjectId], references: [id])
  scores            AssessmentScore[]

  @@unique([schoolId, academicTermId, classArmId, subjectId, name], map: "AssessmentDefinition_schoolId_academicTermId_classArmId_subject")
  @@index([schoolId, classArmId, subjectId])
  @@index([schoolId, academicSessionId, academicTermId], map: "AssessmentDefinition_schoolId_academicSessionId_academicTermId_")
}

model Student {
  id                      String                    @id @default(uuid()) @db.Uuid
  schoolId                String                    @db.Uuid
  admissionNumber         String
  firstName               String
  middleName              String?
  lastName                String
  dateOfBirth             DateTime?                 @db.Date
  status                  StudentStatus             @default(ACTIVE)
  createdAt               DateTime                  @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime                  @updatedAt @db.Timestamptz(6)
  assessmentScores        AssessmentScore[]
  attendanceRecords       AttendanceRecord[]
  enrollments             Enrollment[]
  PaymentRecord           PaymentRecord[]
  ResultAccessEntitlement ResultAccessEntitlement[]
  ResultAccessTransaction ResultAccessTransaction[]
  ResultPaymentAttempt    ResultPaymentAttempt[]
  school                  School                    @relation(fields: [schoolId], references: [id])
  StudentFeeAssignment    StudentFeeAssignment[]
  StudentFeeInvoice       StudentFeeInvoice[]
  studentGuardians        StudentGuardian[]

  @@unique([schoolId, admissionNumber])
  @@index([schoolId, lastName, firstName])
}

model Guardian {
  id                      String                   @id @default(uuid()) @db.Uuid
  schoolId                String                   @db.Uuid
  fullName                String
  phone                   String?
  email                   String?
  createdAt               DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime                 @updatedAt @db.Timestamptz(6)
  userId                  String?                  @unique @db.Uuid
  school                  School                   @relation(fields: [schoolId], references: [id])
  User                    User?                    @relation(fields: [userId], references: [id], onUpdate: NoAction)
  GuardianAccountSecurity GuardianAccountSecurity?
  ParentAccessInvitation  ParentAccessInvitation[]
  studentGuardians        StudentGuardian[]

  @@index([schoolId, fullName])
  @@index([schoolId, phone])
}

model StudentGuardian {
  studentId    String   @db.Uuid
  guardianId   String   @db.Uuid
  schoolId     String   @db.Uuid
  relationship String?
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  guardian     Guardian @relation(fields: [guardianId], references: [id])
  school       School   @relation(fields: [schoolId], references: [id])
  student      Student  @relation(fields: [studentId], references: [id])

  @@id([studentId, guardianId])
  @@index([schoolId, guardianId])
  @@index([schoolId, studentId])
}

model Enrollment {
  id                String             @id @default(uuid()) @db.Uuid
  studentId         String             @db.Uuid
  academicSessionId String             @db.Uuid
  classArmId        String             @db.Uuid
  status            EnrollmentStatus   @default(ACTIVE)
  enrolledAt        DateTime           @default(now()) @db.Timestamptz(6)
  endedAt           DateTime?          @db.Timestamptz(6)
  assessmentScores  AssessmentScore[]
  attendanceRecords AttendanceRecord[]
  academicSession   AcademicSession    @relation(fields: [academicSessionId], references: [id])
  classArm          ClassArm           @relation(fields: [classArmId], references: [id])
  student           Student            @relation(fields: [studentId], references: [id])

  @@unique([studentId, academicSessionId])
  @@index([academicSessionId, classArmId, status])
  @@index([studentId, status])
}

model AssessmentScore {
  id                String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId          String               @db.Uuid
  academicSessionId String               @db.Uuid
  assessmentId      String               @db.Uuid
  classArmId        String               @db.Uuid
  subjectId         String               @db.Uuid
  studentId         String               @db.Uuid
  enrollmentId      String               @db.Uuid
  score             Decimal              @db.Decimal(10, 2)
  createdAt         DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime             @default(now()) @updatedAt @db.Timestamptz(6)
  academicSession   AcademicSession      @relation(fields: [academicSessionId], references: [id])
  assessment        AssessmentDefinition @relation(fields: [assessmentId], references: [id])
  classArm          ClassArm             @relation(fields: [classArmId], references: [id])
  enrollment        Enrollment           @relation(fields: [enrollmentId], references: [id])
  school            School               @relation(fields: [schoolId], references: [id])
  student           Student              @relation(fields: [studentId], references: [id])
  subject           Subject              @relation(fields: [subjectId], references: [id])

  @@unique([assessmentId, studentId])
  @@index([schoolId, studentId])
  @@index([schoolId, academicSessionId, classArmId, subjectId], map: "AssessmentScore_schoolId_academicSessionId_classArmId_subjectId")
}

model AttendanceRecord {
  id                String           @id @default(uuid()) @db.Uuid
  schoolId          String           @db.Uuid
  academicSessionId String           @db.Uuid
  classArmId        String           @db.Uuid
  studentId         String           @db.Uuid
  enrollmentId      String           @db.Uuid
  attendanceDate    DateTime         @db.Date
  status            AttendanceStatus
  note              String?
  recordedByUserId  String           @db.Uuid
  recordedAt        DateTime         @default(now()) @db.Timestamptz(6)
  academicSession   AcademicSession  @relation(fields: [academicSessionId], references: [id])
  classArm          ClassArm         @relation(fields: [classArmId], references: [id])
  enrollment        Enrollment       @relation(fields: [enrollmentId], references: [id])
  school            School           @relation(fields: [schoolId], references: [id])
  student           Student          @relation(fields: [studentId], references: [id])

  @@unique([studentId, attendanceDate])
  @@index([schoolId, attendanceDate, classArmId])
  @@index([academicSessionId, attendanceDate])
}

model Membership {
  id                     String                  @id @default(uuid()) @db.Uuid
  userId                 String                  @db.Uuid
  organizationId         String                  @db.Uuid
  schoolId               String                  @db.Uuid
  isOwner                Boolean                 @default(false)
  status                 MembershipStatus        @default(ACTIVE)
  createdAt              DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime                @updatedAt @db.Timestamptz(6)
  organization           Organization            @relation(fields: [organizationId], references: [id])
  school                 School                  @relation(fields: [schoolId], references: [id])
  user                   User                    @relation(fields: [userId], references: [id])
  capabilities           MembershipCapability[]
  NotificationPreference NotificationPreference?
  NotificationRecipient  NotificationRecipient[]

  @@unique([userId, schoolId])
  @@index([organizationId, schoolId])
  @@index([schoolId, isOwner])
}

model Capability {
  id          String                 @id @default(uuid()) @db.Uuid
  code        String                 @unique
  description String?
  createdAt   DateTime               @default(now())
  memberships MembershipCapability[]
}

model MembershipCapability {
  membershipId String     @db.Uuid
  capabilityId String     @db.Uuid
  schoolId     String     @db.Uuid
  createdAt    DateTime   @default(now())
  capability   Capability @relation(fields: [capabilityId], references: [id])
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  school       School     @relation(fields: [schoolId], references: [id])

  @@id([membershipId, capabilityId])
  @@index([schoolId, capabilityId])
}

model UserSession {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  tokenHash    String    @unique
  expiresAt    DateTime  @db.Timestamptz(6)
  lastActiveAt DateTime  @default(now()) @db.Timestamptz(6)
  revokedAt    DateTime? @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model AuditEvent {
  id            String   @id @default(uuid()) @db.Uuid
  schoolId      String?  @db.Uuid
  actorUserId   String?  @db.Uuid
  action        String
  entityType    String
  entityId      String?
  previousState Json?
  currentState  Json?
  metadata      Json?
  occurredAt    DateTime @default(now()) @db.Timestamptz(6)
  actor         User?    @relation("AuditActor", fields: [actorUserId], references: [id])
  school        School?  @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  @@index([schoolId, occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([entityType, entityId])
}

model FeeStructure {
  id                   String                 @id @default(uuid()) @db.Uuid
  schoolId             String                 @db.Uuid
  academicSessionId    String                 @db.Uuid
  academicTermId       String                 @db.Uuid
  name                 String
  amount               Decimal                @db.Decimal(12, 2)
  description          String?
  dueDate              DateTime?              @db.Date
  isActive             Boolean                @default(true)
  createdAt            DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime               @updatedAt @db.Timestamptz(6)
  academicSession      AcademicSession        @relation(fields: [academicSessionId], references: [id])
  academicTerm         AcademicTerm           @relation(fields: [academicTermId], references: [id])
  school               School                 @relation(fields: [schoolId], references: [id])
  StudentFeeAssignment StudentFeeAssignment[]

  @@unique([schoolId, academicTermId, name])
  @@index([schoolId, academicSessionId, academicTermId])
  @@index([schoolId, isActive])
}

model SchoolSubscription {
  id                 String             @id @default(uuid()) @db.Uuid
  schoolId           String             @unique @db.Uuid
  planCode           CommercialPlanCode @default(FREE)
  billingPeriod      BillingPeriod      @default(MONTHLY)
  status             SubscriptionStatus @default(ACTIVE)
  currentPeriodStart DateTime?          @db.Timestamptz(6)
  currentPeriodEnd   DateTime?          @db.Timestamptz(6)
  cancelAtPeriodEnd  Boolean            @default(false)
  createdAt          DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @db.Timestamptz(6)
  school             School             @relation(fields: [schoolId], references: [id])

  @@index([planCode, status])
  @@index([currentPeriodEnd])
}

model ResultAccessSetting {
  id          String   @id @default(uuid()) @db.Uuid
  schoolId    String   @unique @db.Uuid
  enabled     Boolean  @default(false)
  amountNaira Decimal  @default(0) @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)
  school      School   @relation(fields: [schoolId], references: [id])
}

model GuardianAccountSecurity {
  guardianId         String    @id @db.Uuid
  userId             String    @unique @db.Uuid
  mustChangePassword Boolean   @default(true)
  emailVerifiedAt    DateTime? @db.Timestamptz(6)
  phoneVerifiedAt    DateTime? @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime  @default(now()) @db.Timestamptz(6)
  Guardian           Guardian  @relation(fields: [guardianId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  User               User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([emailVerifiedAt])
  @@index([phoneVerifiedAt])
  @@index([userId])
}

model GuardianPhoneVerificationToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(6)
  usedAt    DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  User      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId, expiresAt])
}

model IdempotencyRecord {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId  String   @db.Uuid
  key       String
  operation String
  result    Json?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  School    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, key, operation])
  @@index([schoolId, createdAt])
}

model Notification {
  id                    String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId              String                  @db.Uuid
  title                 String
  body                  String
  createdByUserId       String                  @db.Uuid
  createdAt             DateTime                @default(now()) @db.Timestamptz(6)
  User                  User                    @relation(fields: [createdByUserId], references: [id], onUpdate: NoAction)
  School                School                  @relation(fields: [schoolId], references: [id], onUpdate: NoAction)
  NotificationRecipient NotificationRecipient[]

  @@index([schoolId, createdAt])
}

model NotificationPreference {
  membershipId    String     @id @db.Uuid
  inAppEnabled    Boolean    @default(true)
  smsEnabled      Boolean    @default(false)
  emailEnabled    Boolean    @default(false)
  whatsappEnabled Boolean    @default(false)
  updatedAt       DateTime   @default(now()) @db.Timestamptz(6)
  Membership      Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model NotificationRecipient {
  notificationId String       @db.Uuid
  membershipId   String       @db.Uuid
  readAt         DateTime?    @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  Membership     Membership   @relation(fields: [membershipId], references: [id], onUpdate: NoAction)
  Notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([notificationId, membershipId])
  @@index([membershipId, readAt])
}

model ParentAccessInvitation {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId        String    @db.Uuid
  guardianId      String    @db.Uuid
  tokenHash       String    @unique
  expiresAt       DateTime  @db.Timestamptz(6)
  usedAt          DateTime? @db.Timestamptz(6)
  createdByUserId String    @db.Uuid
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  User            User      @relation(fields: [createdByUserId], references: [id], onUpdate: NoAction)
  Guardian        Guardian  @relation(fields: [guardianId], references: [id], onUpdate: NoAction)
  School          School    @relation(fields: [schoolId], references: [id], onUpdate: NoAction)

  @@index([guardianId, usedAt])
  @@index([schoolId, createdAt])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model PaymentIntent {
  id                         String            @id @db.Uuid
  schoolId                   String            @db.Uuid
  invoiceId                  String            @db.Uuid
  provider                   String
  reference                  String            @unique
  amount                     Decimal           @db.Decimal(12, 2)
  currency                   String            @default("NGN")
  status                     String            @default("INITIALIZED")
  checkoutUrl                String?
  providerTransactionId      String?
  createdAt                  DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt                  DateTime          @default(now()) @db.Timestamptz(6)
  settlementAccountReference String?
  StudentFeeInvoice          StudentFeeInvoice @relation(fields: [invoiceId], references: [id])
  School                     School            @relation(fields: [schoolId], references: [id])

  @@index([schoolId, createdAt])
  @@index([schoolId, invoiceId, status])
}

model PaymentRecord {
  id                String            @id @db.Uuid
  schoolId          String            @db.Uuid
  studentId         String            @db.Uuid
  invoiceId         String            @db.Uuid
  amount            Decimal           @db.Decimal(12, 2)
  paidAt            DateTime          @default(now()) @db.Timestamptz(6)
  reference         String?
  note              String?
  recordedByUserId  String?           @db.Uuid
