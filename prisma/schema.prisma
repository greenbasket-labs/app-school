generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus { ACTIVE LOCKED DISABLED }
enum OrganizationStatus { SETUP ACTIVE SUSPENDED CLOSED }
enum SchoolStatus { SETUP ACTIVE SUSPENDED CLOSED }
enum SetupStatus { NOT_STARTED ORGANIZATION_CREATED SCHOOL_INFORMATION_REQUIRED CAC_REQUIRED IDENTITY_READY COMPLETED }
enum MembershipStatus { ACTIVE SUSPENDED ENDED }
enum IdentityVerificationStatus { SUPPLIED VERIFIED REJECTED REVIEW_REQUIRED }
enum AcademicSessionStatus { DRAFT ACTIVE CLOSED }
enum StudentStatus { ACTIVE INACTIVE WITHDRAWN }
enum EnrollmentStatus { ACTIVE COMPLETED WITHDRAWN }
enum AttendanceStatus { PRESENT ABSENT LATE EXCUSED }

model User {
  id String @id @default(uuid()) @db.Uuid
  email String @unique
  passwordHash String
  status UserStatus @default(ACTIVE)
  memberships Membership[]
  sessions UserSession[]
  auditEvents AuditEvent[] @relation("AuditActor")
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
}
model Organization {
  id String @id @default(uuid()) @db.Uuid
  name String
  normalizedName String
  status OrganizationStatus @default(SETUP)
  identity OrganizationIdentity?
  schools School[]
  memberships Membership[]
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
}
model OrganizationIdentity {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @unique @db.Uuid
  cacNumber String
  normalizedCacNumber String @unique
  verificationStatus IdentityVerificationStatus @default(SUPPLIED)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
}
model School {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  name String
  normalizedName String
  address String?
  phone String?
  email String?
  status SchoolStatus @default(SETUP)
  setupStatus SetupStatus @default(NOT_STARTED)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  memberships Membership[]
  membershipCapabilities MembershipCapability[]
  modules SchoolModule[]
  academicSessions AcademicSession[]
  classLevels ClassLevel[]
  subjects Subject[]
  students Student[]
  guardians Guardian[]
  attendanceRecords AttendanceRecord[]
  assessments AssessmentDefinition[]
  auditEvents AuditEvent[]
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  @@index([organizationId])
  @@index([normalizedName])
}
model Module {
  id String @id @default(uuid()) @db.Uuid
  code String @unique
  name String
  description String?
  category String
  sortOrder Int @default(0)
  schoolModules SchoolModule[]
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
}
model SchoolModule {
  schoolId String @db.Uuid
  moduleId String @db.Uuid
  enabled Boolean @default(false)
  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  module Module @relation(fields: [moduleId], references: [id], onDelete: Restrict)
  enabledAt DateTime? @db.Timestamptz(6)
  disabledAt DateTime? @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  @@id([schoolId, moduleId])
  @@index([schoolId, enabled])
}
model AcademicSession {
  id String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid
  name String
  startsAt DateTime @db.Timestamptz(6)
  endsAt DateTime @db.Timestamptz(6)
  status AcademicSessionStatus @default(DRAFT)
  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  terms AcademicTerm[]
  classSubjects ClassSubject[]
  enrollments Enrollment[]
  attendanceRecords AttendanceRecord[]
  assessments AssessmentDefinition[]
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  @@unique([schoolId, name])
  @@index([schoolId, startsAt])
}
model AcademicTerm {
  id String @id @default(uuid()) @db.Uuid
  name String
  order Int
  startsAt DateTime @db.Timestamptz(6)
  endsAt DateTime @db.Timestamptz(6)
  academicSessionId String @db.Uuid
  academicSession AcademicSession @relation(fields: [academicSessionId], references: [id], onDelete: Restrict)
  assessments AssessmentDefinition[]
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  @@unique([academicSessionId, order])
  @@unique([academicSessionId, name])
  @@index([academicSessionId, startsAt])
}
model ClassLevel {
  id String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid
  name String
  order Int
  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  arms ClassArm[]
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  @@unique([schoolId, name])
  @@unique([schoolId, order])
  @@index([schoolId, order])
}
model ClassArm {
  id String @id @default(uuid()) @db.Uuid
  classLevelId String @db.Uuid
  name String
  classLevel ClassLevel @relation(fields: [classLevelId], references: [id], onDelete: Restrict)
  subjects ClassSubject[]
  enrollments Enrollment[]
  attendanceRecords AttendanceRecord[]
  assessments AssessmentDefinition[]
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  @@unique([classLevelId, name])
  @@index([classLevelId])
}
model Subject {
  id String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid
  name String
  code String?
  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  classSubjects ClassSubject[]
  assessments AssessmentDefinition[]
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  @@unique([schoolId, name])
  @@unique([schoolId, code])
  @@index([schoolId, name])
}
model ClassSubject {
  id String @id @default(uuid()) @db.Uuid
  academicSessionId String @db.Uuid
  classArmId String @db.Uuid
  subjectId String @db.Uuid
  academicSession AcademicSession @relation(fields: [academicSessionId], references: [id], onDelete: Restrict)
  classArm ClassArm @relation(fields: [classArmId], references: [id], onDelete: Restrict)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  @@unique([academicSessionId, classArmId, subjectId])
  @@index([academicSessionId, classArmId])
  @@index([academicSessionId, subjectId])
}
model AssessmentDefinition {
  id String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid
  academicSessionId String @db.Uuid
  academicTermId String @db.Uuid
  classArmId String @db.Uuid
  subjectId String @db.Uuid
  name String
  maxScore Decimal @db.Decimal(10, 2)
  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  academicSession AcademicSession @relation(fields: [academicSessionId], references: [id], onDelete: Restrict)
  academicTerm AcademicTerm @relation(fields: [academicTermId], references: [id], onDelete: Restrict)
  classArm ClassArm @relation(fields: [classArmId], references: [id], onDelete: Restrict)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  @@unique([schoolId, academicTermId, classArmId, subjectId, name])
  @@index([schoolId, academicSessionId, academicTermId])
  @@index([schoolId, classArmId, subjectId])
}
model Student {
  id String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid
  admissionNumber String
  firstName String
  middleName String?
  lastName String
  dateOfBirth DateTime? @db.Date
  status StudentStatus @default(ACTIVE)
  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  enrollments Enrollment[]
  attendanceRecords AttendanceRecord[]
  studentGuardians StudentGuardian[]
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  @@unique([schoolId, admissionNumber])
  @@index([schoolId, lastName, firstName])
}
model Guardian {
  id String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid
  fullName String
  phone String?
  email String?
  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  studentGuardians StudentGuardian[]
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  @@index([schoolId, fullName])
  @@index([schoolId, phone])
}
model StudentGuardian {
  studentId String @db.Uuid
  guardianId String @db.Uuid
  schoolId String @db.Uuid
  relationship String?
  isPrimary Boolean @default(false)
  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Restrict)
  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  @@id([studentId, guardianId])
  @@index([schoolId, guardianId])
  @@index([schoolId, studentId])
}
model Enrollment {
  id String @id @default(uuid()) @db.Uuid
  studentId String @db.Uuid
  academicSessionId String @db.Uuid
  classArmId String @db.Uuid
  status EnrollmentStatus @default(ACTIVE)
  enrolledAt DateTime @default(now()) @db.Timestamptz(6)
  endedAt DateTime? @db.Timestamptz(6)
  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  academicSession AcademicSession @relation(fields: [academicSessionId], references: [id], onDelete: Restrict)
  classArm ClassArm @relation(fields: [classArmId], references: [id], onDelete: Restrict)
  attendanceRecords AttendanceRecord[]
  @@unique([studentId, academicSessionId])
  @@index([academicSessionId, classArmId, status])
  @@index([studentId, status])
}
model AttendanceRecord {
  id String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid
  academicSessionId String @db.Uuid
  classArmId String @db.Uuid
  studentId String @db.Uuid
  enrollmentId String @db.Uuid
  attendanceDate DateTime @db.Date
  status AttendanceStatus
  note String?
  recordedByUserId String @db.Uuid
  recordedAt DateTime @default(now()) @db.Timestamptz(6)
  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  academicSession AcademicSession @relation(fields: [academicSessionId], references: [id], onDelete: Restrict)
  classArm ClassArm @relation(fields: [classArmId], references: [id], onDelete: Restrict)
  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  @@unique([studentId, attendanceDate])
  @@index([schoolId, attendanceDate, classArmId])
  @@index([academicSessionId, attendanceDate])
}
model Membership {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  organizationId String @db.Uuid
  schoolId String @db.Uuid
  isOwner Boolean @default(false)
  status MembershipStatus @default(ACTIVE)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  capabilities MembershipCapability[]
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  @@unique([userId, schoolId])
  @@index([organizationId, schoolId])
  @@index([schoolId, isOwner])
}
model Capability {
  id String @id @default(uuid()) @db.Uuid
  code String @unique
  description String?
  memberships MembershipCapability[]
  createdAt DateTime @default(now())
}
model MembershipCapability {
  membershipId String @db.Uuid
  capabilityId String @db.Uuid
  schoolId String @db.Uuid
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  capability Capability @relation(fields: [capabilityId], references: [id], onDelete: Restrict)
  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  @@id([membershipId, capabilityId])
  @@index([schoolId, capabilityId])
}
model UserSession {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  tokenHash String @unique
  expiresAt DateTime @db.Timestamptz(6)
  lastActiveAt DateTime @default(now()) @db.Timestamptz(6)
  revokedAt DateTime? @db.Timestamptz(6)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  @@index([userId, expiresAt])
}
model AuditEvent {
  id String @id @default(uuid()) @db.Uuid
  schoolId String? @db.Uuid
  actorUserId String? @db.Uuid
  action String
  entityType String
  entityId String?
  previousState Json?
  currentState Json?
  metadata Json?
  school School? @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  actor User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  occurredAt DateTime @default(now()) @db.Timestamptz(6)
  @@index([schoolId, occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([entityType, entityId])
}
